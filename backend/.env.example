# NVIDIA NIM API Key - Get from build.nvidia.com
# For Kimi-K2.6 (General AI Chat Model) - moonshotai/kimi-k2.6
NVIDIA_API_KEY_KIMI=YOUR_NVIDIA_API_KEY
NVIDIA_API_KEY_GLM=YOUR_NVIDIA_API_KEY
NVIDIA_API_KEY_DEEPSEEK_PRO=YOUR_NVIDIA_API_KEY
NVIDIA_API_KEY_DEEPSEEK_FLASH=YOUR_NVIDIA_API_KEY


# For Groq (Document RAG - Llama 3.3 70B) - console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY

# For Gemini (Leader/Reviewer AI) - aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Qdrant Cloud - Create free cluster at cloud.qdrant.io
QDRANT_URL=https://xxxxx.qdrant.io
QDRANT_KEY=xxxxx

# Supabase - Create free project at supabase.com
# Get these from Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=xxxxx
